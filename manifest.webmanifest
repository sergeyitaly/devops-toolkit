{
  "name": "DevOps Pocket Toolkit",
  "short_name": "DevOps Toolkit",
  "description": "Twelve offline DevOps utilities in one page: CIDR and subnet maths, base64, URL encoding, regex, JWT, timestamps, UUIDs, passwords, hashes, JSON and YAML.",
  "id": "devops-pocket-toolkit",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0e13",
  "theme_color": "#0b0e13",
  "categories": [
    "utilities",
    "developer"
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "CIDR Calculator",
      "short_name": "CIDR",
      "description": "Network, broadcast, mask and host range",
      "url": "./#/cidr",
      "icons": [
        {
          "src": "./icons/tools/cidr.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Subnet Splitter",
      "short_name": "Subnets",
      "description": "Carve a block into equal subnets",
      "url": "./#/subnet",
      "icons": [
        {
          "src": "./icons/tools/subnet.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Base64",
      "short_name": "Base64",
      "description": "Encode and decode base64",
      "url": "./#/base64",
      "icons": [
        {
          "src": "./icons/tools/base64.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "URL Encoder",
      "short_name": "URL",
      "description": "Percent-encoding and query parsing",
      "url": "./#/url",
      "icons": [
        {
          "src": "./icons/tools/url.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Regex Tester",
